NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# Administração de usuários (somente no ambiente do servidor/Vercel)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Envio de e-mails de status e de ATAs (somente no ambiente do servidor/Vercel)
# Opcional para encerrar uma RA; configure ambos para enviar a ATA.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Terra Lotus <projetos@seudominio.com.br>

# Geração da versão 1 de Processos por PDF (somente no servidor/Vercel)
OPENAI_API_KEY=
# Opcional: modelo usado exclusivamente para estruturar os processos
OPENAI_PROCESS_MODEL=gpt-5.6

# Sincronização semanal do NPS (somente no ambiente do servidor/Vercel)
ASCSAC_USERNAME=
ASCSAC_PASSWORD=
ASCSAC_SURVEY_ID=1
CRON_SECRET=

# Sincronização semanal da inadimplência no Qlik Cloud (somente servidor/Vercel)
QLIK_USERNAME=
QLIK_PASSWORD=
# Opcionais: use somente se a planilha ou o objeto mudar no Qlik
QLIK_DELINQUENCY_SHEET_URL=
QLIK_DELINQUENCY_TABLE_OBJECT_ID=jJTqUzF
